{
  "version": "1.0.0",
  "main": "index.js",
  "license": "ISC",
  "type": "module",
  "description": "ApexFitness Backend",
  "scripts": {
    "dev": "nodemon",
    "build": "tsc",
    "serve": "node dist/index.js",
    "db:start": "npx supabase start",
    "db:stop": "npx supabase stop",
    "db:status": "npx supabase status",
    "db:reset": "npx supabase db reset",
    "db:push": "npx supabase db push",
    "db:login": "npx supabase login"
  },
  "nodemonConfig": {
    "watch": [
      "src"
    ],
    "ext": "ts",
    "exec": "tsx src/index.ts",
    "legacyWatch": true
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.106.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "nodemon": "^3.1.14",
    "supabase": "^2.104.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  }
}
