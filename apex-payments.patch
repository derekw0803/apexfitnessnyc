+import Link from 'next/link';
+
+export const metadata = {
+  title: 'Refund Policy | APEX Human Performance',
+  description:
+    'APEX Human Performance refund policy, including the terms of the 90-day results commitment.',
+};
+
+const updated = 'August 17, 2026';
+
+export default function RefundPolicyPage() {
+  return (
+    <div className="section" style={{ minHeight: 'calc(100vh - 72px)' }}>
+      <div className="section-inner" style={{ maxWidth: 760 }}>
+        <div className="section-label">Legal</div>
+        <h2 id="refund-policy" className="section-h2">Refund Policy</h2>
+        <p className="section-sub" style={{ maxWidth: 760 }}>Last updated: {updated}</p>
+
+        <div style={{ marginTop: '3rem', color: 'var(--muted)', fontSize: '0.95rem', lineHeight: 1.8 }}>
+          <p>
+            This policy explains when you can get your money back, how to ask, and how long it takes.
+            It applies to every program and service purchased through this website. Nothing here
+            limits any right you have under applicable consumer protection law.
+          </p>
+
+          <h3 id="cooling-off" style={sectionHeading}>1. 14-Day Cooling-Off Period</h3>
+          <p>
+            You may cancel any program within <strong style={{ color: 'var(--cream)' }}>14 days</strong>{' '}
+            of purchase for a full refund, provided you have not completed more than two coaching
+            sessions and have not downloaded the complete program materials. Simply email us and ask —
+            no explanation required.
+          </p>
+
+          <h3 id="results-commitment" style={sectionHeading}>2. The 90-Day Results Commitment</h3>
+          <p>
+            We advertise a 90-day results commitment on our 3-month program. Here is exactly what that
+            means, so there is no ambiguity on either side.
+          </p>
+          <p>
+            <strong style={{ color: 'var(--cream)' }}>What we commit to:</strong> if you complete the
+            full 12-week program as prescribed and do not achieve measurable progress against the
+            baseline metrics recorded at your intake, we will refund the program fee in full.
+          </p>
+          <p><strong style={{ color: 'var(--cream)' }}>What &quot;as prescribed&quot; requires:</strong></p>
+          <ul style={listStyle}>
+            <li>You completed your intake and recorded baseline measurements at the start</li>
+            <li>You logged at least 80% of prescribed training sessions</li>
+            <li>You submitted your scheduled check-ins with your coach</li>
+            <li>You followed the nutrition guidance provided, or told your coach why you could not</li>
+            <li>You raise the claim within 30 days of finishing the 12-week program</li>
+          </ul>
+          <p>
+            These conditions exist because we cannot be accountable for a program that was not
+            followed. If your circumstances changed mid-program — injury, illness, a family emergency —
+            tell us. We would rather pause your program or work something out than hold you to a
+            technicality.
+          </p>
+          <p style={{ marginTop: '1.5rem' }}>
+            <strong style={{ color: 'var(--cream)' }}>Important:</strong> this is a commitment about
+            your money, not a medical or physiological guarantee. Individual results vary
+            substantially based on genetics, starting condition, age, adherence, sleep, stress, and
+            medical history. No coach can guarantee a specific physical outcome, and we do not claim
+            to. What we guarantee is that if you do the work and it does not work, you do not pay.
+          </p>
+
+          <h3 id="one-on-one" style={sectionHeading}>3. 1-on-1 Coaching Sessions</h3>
+          <p>
+            Unused sessions are refundable at any time. Sessions already delivered are not
+            refundable. Cancellations made more than 24 hours before a scheduled session are
+            rescheduled at no cost; later cancellations or no-shows consume the session.
+          </p>
+
+          <h3 id="nutrition-plans" style={sectionHeading}>4. Customized Nutrition Plans</h3>
+          <p>
+            Because these are built individually for you, they are refundable in full before the plan
+            is delivered. Once your personalized plan has been sent, refunds are available at our
+            discretion — but if the plan does not reflect what you asked for, we will revise it or
+            refund you.
