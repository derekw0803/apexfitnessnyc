@@ -0,0 +1,34 @@
+# ---------------------------------------------------------------------------
+# APEX frontend environment variables
+#
+# Copy to .env.local for local development. In production, set these in
+# Vercel -> Project Settings -> Environment Variables.
+#
+# NEVER commit real values. NEVER prefix a secret with NEXT_PUBLIC_ — that
+# prefix ships the value to the browser in plain text.
+# ---------------------------------------------------------------------------
+
+# --- Site ---
+# Canonical public URL. Used to build Stripe success/cancel redirect URLs.
+NEXT_PUBLIC_SITE_URL=https://apexfitness.fit
+
+# --- Stripe ---
+# Secret key. Server-only. Starts sk_test_ in test mode, sk_live_ when live.
+STRIPE_SECRET_KEY=sk_test_replace_me
+
+# Webhook signing secret from Stripe -> Developers -> Webhooks.
+# Starts whsec_. Each endpoint (local CLI vs production) has its own value.
+STRIPE_WEBHOOK_SECRET=whsec_replace_me
+
+# --- Supabase ---
+# Project URL, e.g. https://xxxxxxxx.supabase.co
+SUPABASE_URL=https://replace_me.supabase.co
+
+# Service-role key. Server-only. Bypasses Row Level Security — treat it like a
+# database password. Found in Supabase -> Project Settings -> API.
+SUPABASE_SERVICE_ROLE_KEY=replace_me
+
+# --- Booking (optional) ---
+# Scheduling link shown after purchase for 1-on-1 coaching and nutrition plans.
+# e.g. a Cal.com or Calendly URL. Leave unset to show generic copy instead.
+NEXT_PUBLIC_BOOKING_URL=
